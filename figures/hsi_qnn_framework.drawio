        <mxCell id="fusion" value="&lt;b&gt;Gated Fusion&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;gate = learned confidence&lt;br&gt;final logits = base + gate x qnn&lt;br&gt;CE + SupCon / Prototype loss&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff4de;strokeColor=#e4a945;shadow=1;fontSize=17;fontColor=#1e2d3a;align=left;spacingLeft=22;verticalAlign=top;spacingTop=18;" vertex="1" parent="1">
